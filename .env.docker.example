# 复制为 .env.docker 后填写。不要提交或 COPY 到镜像，尤其不要上传到公开仓库。

# 交建通回调（生产环境必填）
JJT_CALLBACK_TOKEN=replace_with_callback_token
JJT_ENCODING_AES_KEY=replace_with_43_char_encoding_aes_key
JJT_RECEIVE_ID=
ENABLE_JJT_CALLBACK=true

# 容器内持久化路径
JJT_MESSAGE_DATA_DIR=/app/data/messages
DATABASE_URL=sqlite:////app/data/jjt_bot.db

# 应用
APP_ENV=production
ENABLE_MOCK_API=false
JJT_LOG_LEVEL=INFO
JJT_TIMEZONE=Asia/Shanghai

# 日报大模型（不启用可留空）
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=90
LLM_MAX_RETRIES=1

# 图片识别模型（API Key/Base URL 留空时沿用 LLM 配置；MODEL 仍需填写）
VISION_API_KEY=
VISION_MODEL=
VISION_BASE_URL=
VISION_TIMEOUT_SECONDS=90
VISION_MAX_RETRIES=1
IMAGE_DOWNLOAD_TIMEOUT_SECONDS=15
IMAGE_MAX_BYTES=10000000
ENABLE_AUTO_IMAGE_RECOGNITION=false

# 真实回复发送（确认联调无误后再开启）
ENABLE_REAL_RESPONSE_SEND=false
RESPONSE_SEND_TIMEOUT_SECONDS=10
